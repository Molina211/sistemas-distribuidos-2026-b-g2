# Every variable the service reads. Copy to .env (git-ignored) for a local run;
# the real .env is never committed. Values here are placeholders. Keep values in
# single quotes: the file is loaded with ". ./.env".

# Address the HTTP server listens on.
HTTP_ADDR=:8080

# Secrets: set NAME, or set NAME_FILE to a file mounted by the secret store
# (Docker secret, CI secret written to a file). NAME_FILE wins if both are set.
DATABASE_URL='postgres://security_app:<password>@localhost:5432/multitour?search_path=security'
# DATABASE_URL_FILE=/run/secrets/database_url
JWT_PRIVATE_KEY_FILE='./keys/jwt-private.pem'
# JWT_PRIVATE_KEY='<pem contents>'

# Feature flags: true or false, default false.
FEATURE_TOKEN_REVOCATION=false
