# Names and placeholders only. Copy to ../.env and fill in locally.
ORDERS_DB_NAME=orders
ORDERS_DB_USER=orders_owner
ORDERS_DB_PASSWORD=

# Identity: the public key every service validates tokens with, and the token
# the worker and the workflow present.
# In main they come from the identity service, as secrets: never these files.
JWT_PUBLIC_KEY=
SERVICE_TOKEN=
