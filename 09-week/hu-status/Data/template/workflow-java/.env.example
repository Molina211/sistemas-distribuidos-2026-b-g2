# Names and placeholders only: never a real value. Copy to .env for local runs.
PORT=8081
ORDERS_API_URL=http://localhost:8080
INVENTORY_API_URL=http://localhost:8082
PAYMENTS_API_URL=http://localhost:8083
# Public key of the identity service (one line, \n escapes) — or JWT_PUBLIC_KEY_FILE.
JWT_PUBLIC_KEY=
# Service token issued by the identity service for this process.
SERVICE_TOKEN=
HTTP_ATTEMPTS=3
HTTP_TIMEOUT_SECONDS=5
